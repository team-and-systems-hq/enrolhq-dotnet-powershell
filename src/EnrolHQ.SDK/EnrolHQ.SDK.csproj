<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EnrolHQ.SDK</RootNamespace>
    <AssemblyName>EnrolHQ.SDK</AssemblyName>
    <Version>1.1.0</Version>
    <Authors>Team and Systems HQ</Authors>
    <Description>C# SDK for the EnrolHQ school enrolments and admissions API</Description>
    <PackageId>EnrolHQ.SDK</PackageId>
    <PackageTags>enrolhq;school;enrolment;admissions;api;sdk</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/team-and-systems-hq/enrolhq-dotnet-powershell</PackageProjectUrl>
    <RepositoryUrl>https://github.com/team-and-systems-hq/enrolhq-dotnet-powershell</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EnrolHQ.SDK.Tests" />
  </ItemGroup>

</Project>
